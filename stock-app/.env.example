# Base de datos Postgres. En Vercel, agregar "Vercel Postgres" (o Neon) desde el panel
# del proyecto crea esta variable automáticamente. En local, cualquier Postgres sirve:
# DATABASE_URL="postgresql://usuario:password@localhost:5432/stock_app"
DATABASE_URL=""

# Auth.js — generar con: openssl rand -base64 32
AUTH_SECRET=""

# Credenciales OAuth de Google (Google Cloud Console > APIs & Services > Credentials)
# URI de redirección autorizada: https://tu-dominio.com/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Necesario si se despliega detrás de un proxy/dominio propio (Railway, Fly, Render, etc.)
AUTH_TRUST_HOST=true
