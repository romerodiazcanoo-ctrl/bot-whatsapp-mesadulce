# ============================================================
# WhatsApp Cloud API (Meta)
# ============================================================
# Token de acceso permanente de tu App en Meta for Developers
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxx

# ID del número de teléfono registrado en WhatsApp Business
WHATSAPP_PHONE_NUMBER_ID=1234567890

# Token de verificación que eliges tú (para el handshake del webhook)
WHATSAPP_VERIFY_TOKEN=mi_token_secreto_123

# Versión de la API de WhatsApp Cloud
WHATSAPP_API_VERSION=v20.0

# ============================================================
# LLM Provider - Usa UNO de los dos bloques siguientes
# ============================================================

# --- Opción A: Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxx
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6

# --- Opción B: OpenAI (GPT) ---
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxx
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini

# ============================================================
# Webhook de salida (Make / Zapier / n8n / tu backend)
# ============================================================
# URL a la que se enviará el JSON del pedido confirmado
OUTBOUND_WEBHOOK_URL=https://hook.make.com/tu-webhook-aqui

# Token opcional para autenticar el webhook de salida
OUTBOUND_WEBHOOK_SECRET=

# ============================================================
# Sesiones de chat (elige una opción)
# ============================================================
# Opciones: "memory" (en proceso) | "redis"
SESSION_STORE=memory

# Solo necesario si SESSION_STORE=redis
REDIS_URL=redis://localhost:6379

# Tiempo de expiración de la sesión en segundos (default: 30 min)
SESSION_TTL_SECONDS=1800

# ============================================================
# Servidor
# ============================================================
PORT=3000
NODE_ENV=production
LOG_LEVEL=info
